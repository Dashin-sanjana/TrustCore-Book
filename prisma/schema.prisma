// Phase A1/A2 and booking additions require coordinated forward migrations.
// The booking migration is PREPARED, NOT APPLIED; do not enable booking on an old schema.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}
enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  platformAdmin Boolean @default(false)
  emailVerificationRequired Boolean @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  credentialVersion Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  memberships BusinessMember[]
  sentInvitations BusinessInvitation[] @relation("InvitationInviter")
  acceptedInvitations BusinessInvitation[] @relation("InvitationAccepter")
  sessions RefreshSession[]
  securityTokens AccountSecurityToken[]
  auditLogs AuditLog[]
}
model Business {
  id String @id @default(cuid())
  name String
  slug String @unique
  country String
  currency String
  timezone String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  members BusinessMember[]
  invitations BusinessInvitation[]
  staff Staff[]
  services Service[]
  customers Customer[]
  appointments Appointment[]
  bookingRequests BookingRequest[]
  auditLogs AuditLog[]
}
model BusinessMember {
  id String @id @default(cuid())
  businessId String
  userId String
  role MemberRole @default(MEMBER)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([businessId, userId])
  @@index([userId])
}
model BusinessInvitation {
  id String @id @default(cuid())
  businessId String
  invitedEmail String
  role MemberRole
  tokenDigest String @unique
  invitedById String
  acceptedById String?
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  declinedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  @@index([businessId, expiresAt])
  @@index([businessId, invitedEmail, expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
}
model Staff {
  id String @id @default(cuid())
  businessId String
  name String
  active Boolean @default(true)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services StaffService[]
  availability AvailabilityRule[]
  exceptions ScheduleException[]
  appointments Appointment[]
  @@unique([businessId, id])
}
model Service {
  id String @id @default(cuid())
  businessId String
  name String
  durationMinutes Int
  price Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff StaffService[]
  appointments Appointment[]
  @@unique([businessId, id])
}
model StaffService {
  businessId String
  staffId String
  serviceId String
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)
  @@id([businessId, staffId, serviceId])
  @@index([businessId, serviceId])
}
model Customer {
  id String @id @default(cuid())
  businessId String
  name String
  email String?
  phone String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  @@unique([businessId, id])
  @@index([businessId, email])
}
model AvailabilityRule {
  id String @id @default(cuid())
  businessId String
  staffId String
  // Local wall-clock minutes in the business IANA timezone; 0 = Sunday.
  weekday Int
  startMinute Int
  endMinute Int
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  @@index([businessId, staffId, weekday])
}
model ScheduleException {
  id String @id @default(cuid())
  businessId String
  staffId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  unavailable Boolean @default(true)
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  @@index([businessId, staffId, startsAt])
}
model Appointment {
  id String @id @default(cuid())
  businessId String
  staffId String
  serviceId String
  customerId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(CONFIRMED)
  // Snapshot pricing prevents later service edits changing historical totals.
  price Decimal @db.Decimal(12,2)
  currency String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  bookingRequests BookingRequest[]
  @@unique([businessId, id])
  @@index([businessId, startsAt])
}
model BookingRequest {
  id String @id @default(cuid())
  businessId String
  idempotencyKey String
  payloadHash String
  appointmentId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
}
model RefreshSession {
  // Revocation record for Auth.js encrypted JWT, not a browser-exposed refresh token.
  id String @id @default(cuid())
  userId String
  credentialVersion Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model AccountSecurityToken {
  id String @id @default(cuid())
  userId String
  purpose AccountTokenPurpose
  digest String @unique
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}
model AuditLog {
  id String @id @default(cuid())
  businessId String
  actorId String?
  action String
  entityId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([businessId, createdAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}
