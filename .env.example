# Copy to .env only after verifying a disposable development database.
# Never paste credentials into source files, chat, or a production build log.
DATABASE_URL="postgresql://USER:PASSWORD@DIRECT-DEV-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-DEV-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional local-only email outbox for account recovery and invitations.
# See docs/SEPARATE_DEV_PROJECT.md for target verification and approval gates.
# ACCOUNT_EMAIL_PROVIDER=local
# LOCAL_OUTBOX_ENABLED=YES
# LOCAL_OUTBOX_TARGET_APPROVED=YES
# LOCAL_OUTBOX_EXPECTED_ENDPOINT=
# LOCAL_OUTBOX_EXPECTED_DATABASE=
# LOCAL_OUTBOX_NEON_PROJECT_ID=
# LOCAL_OUTBOX_NEON_BRANCH_ID=
# LOCAL_OUTBOX_NEON_BRANCH_NAME=
# LOCAL_OUTBOX_NEON_API_KEY=
# LOCAL_OUTBOX_ACCESS_TOKEN=

# Keep disabled until migrations and database/browser tests pass.
A2_MEMBERSHIP_ENABLED=false
BOOKING_MVP_ENABLED=false
